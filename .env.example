# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). En Vercel, configúralos en Settings → Environment Variables.
#
# Las variables NEXT_PUBLIC_* se incluyen en el código del navegador: usa SOLO la
# clave publishable/anon, protegida por RLS. Nunca pongas aquí la service_role ni
# una sb_secret_*.
#
# Sin estas variables la app funciona en modo local (datos solo en este navegador).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
